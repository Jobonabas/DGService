---
import "../styles/global.css";
import gartenpflege from "../assets/icons/Gartenpflege.svg";
import winterservice from "../assets/icons/Winterservice.svg";
import gebaeudereinigung from "../assets/icons/Gebaeudereinigung.svg";
import hausmeisterservice from "../assets/icons/Hausmeisterservice.svg";

import { sanityClient } from "sanity:client";

type Service = {
  _id: string;
  title: string;
  description: string;
  category: string;
  images: {
    alt?: string;
    url: string;
  }[];
};

const services: Service[] = await sanityClient.fetch(`
  *[_type == "service"] {
    _id,
    title,
    description,
    category,
    images[]{
      alt,
      "url": asset->url
    }
  }
`);

const tabs = [
  { label: "Gartenpflege", category: "gartenpflege", icon:gartenpflege},
  { label: "Winterservice", category: "winterservice", icon: winterservice},
  { label: "Geb\u00E4udereinigung", category: "gebaeudereinigung", icon: gebaeudereinigung},
  { label: "Hausmeisterservice", category: "hausmeisterservice", icon: hausmeisterservice}
];
---



<section class="about-section" id="services" data-services>
  <div
    class="flex flex-wrap justify-center gap-16"
    role="tablist"
    aria-label="Dienstleistungen"
    id="service-tabs"
  >
    { tabs.map((tab, index) => (
      <button
        class="grid place-items-center tab-btn"
        type="button"
        role="tab"
        aria-selected={index === 0 ? "true" : "false"}
        data-service-tab
        data-category={tab.category}
      >
        <img
          src={tab.icon.src}
          alt={`${tab.label} Icon`}
          class="mb-3 h-24 w-auto"
          fetchpriority="high"
        />
        <p class="text-services">{tab.label}</p>
      </button>
    ))}
  </div>
</section>
 
<section class="services-gallery" data-services>
  {services.map((service, index) => (
    <article
      class={`service-panel ${service.category === tabs[0].category ? "is-active" : ""}`}
      role="tabpanel"
      data-service-panel
      data-category={service.category}
    >
      <div class="service-layout">
        <div class="service-slider">
          <div class="service-slider-track">
            {service.images.map((image, imageIndex) => (
              <img
                class={`service-image ${imageIndex === 0 ? "is-active" : ""}`}
                src={image.url}
                alt={image.alt || service.title}
                loading="lazy"
                data-service-image
              />
            ))}
          </div>

          {service.images.length > 1 && (
            <div class="service-slider-controls">
              <button type="button" data-prev-image aria-label="Vorheriges Bild">&#8249;</button>
              <button type="button" data-next-image aria-label="N&auml;chstes Bild">&#8250;</button>
            </div>
          )}

          {service.images.length > 1 && (
            <div class="service-dots">
              {service.images.map((_, imageIndex) => (
                <button
                  type="button"
                  class={`service-dot ${imageIndex === 0 ? "is-active" : ""}`}
                  data-dot={imageIndex}
                  aria-label={`Bild ${imageIndex + 1}`}
                />
              ))}
            </div>
          )}
        </div>

        <div class="service-content">
          <h3 class="service-title">{service.title}</h3>
          <p class="service-description">{service.description}</p>
        </div>
      </div>
    </article>
  ))}
</section>

<script>
  const root = document;
  const tabButtons = root.querySelectorAll<HTMLButtonElement>("[data-service-tab]");
  const panels = root.querySelectorAll<HTMLElement>("[data-service-panel]");

  //Tab-Logik
  const activateCategory = (category: string) => {
    tabButtons.forEach((tab) => {
      const active = tab.dataset.category === category;
      tab.setAttribute("aria-selected", active ? "true" : "false")
    });

    panels.forEach((panel) => {
      const active = panel.dataset.category === category
      panel.classList.toggle("is-active", active);
    })
  };

  tabButtons.forEach((tab) => {
    tab.addEventListener("click", () => {
      const category = tab.dataset.category;
      if (category) {
        activateCategory(category);
      }
    });
  });

//Slider-Logik je Panel
panels.forEach((panel) => {
    const images = panel.querySelectorAll<HTMLImageElement>("[data-service-image]");
    const dots = panel.querySelectorAll<HTMLButtonElement>("[data-dot]");
    const prev = panel.querySelector<HTMLButtonElement>("[data-prev-image]");
    const next = panel.querySelector<HTMLButtonElement>("[data-next-image]");
    if(!images.length) return;
    let currentIndex = 0;

    const updateSlider = () => {
      images.forEach((img, index) => {
        img.classList.toggle("is-active", index === currentIndex);
      });
      dots.forEach((dot, index) => {
        dot.classList.toggle("is-active", index === currentIndex);
      });
    };

    prev?.addEventListener("click", () => {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updateSlider();
    })
    
    next?.addEventListener("click", () => {
      currentIndex = (currentIndex + 1 ) % images.length;
      updateSlider();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const dotIndex = dot.dataset.dot;
        if(dotIndex) {
          currentIndex = Number(dotIndex);
          updateSlider();
        }
      });
    });

    updateSlider();
});
</script>


<style>
  .tab-btn:hover .text-services,
  .tab-btn[aria-selected="true"] .text-services {
    color: #8B5E3C;
    transition: color 0.2s ease;
  }

  .service-panel {
    display: none;
  }

  .service-panel.is-active {
    display: block;
    margin-bottom: 2rem;
  }

  .service-layout {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .service-slider {
    position: relative;
  }

  .service-slider-track {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .service-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: none;
  }

  .service-image.is-active {
    display: block;
  }

  /* Pfeile links/rechts, schwebend über dem Bild */
  .service-slider-controls {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    transform: translateY(-50%);
    padding: 0 1rem;
    pointer-events: none;
    z-index: 2;
  }

  .service-slider-controls button {
    pointer-events: auto;
    font-size: 1.5rem;
    line-height: 1;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.85);
    color: #333;
    cursor: pointer;
    display: grid;
    place-items: center;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .service-slider-controls button:hover {
    background: #fff;
    transform: scale(1.05);
  }

  /* Dots als Pille, schwebend unten mittig */
  .service-dots {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .service-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    background: #ccc;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .service-dot.is-active {
    background: #333;
    transform: scale(1.2);
  }

  .service-content h3 {
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .service-title{
    font-family: 'Courier New', Courier, monospace;
    font-weight: bold;
    font-size: 1.25rem;
    color: #403f3f;
  }

  .service-description{
    font-size: 1rem;
    color: #403f3f;
  }

  @media (max-width: 900px) {
    .service-layout {
      grid-template-columns: 1fr;
    }
  }
</style>