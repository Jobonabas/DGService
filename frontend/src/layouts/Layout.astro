---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>DG Service</title>
	</head>
	<body class="flex min-h-screen flex-col m-0 w-full">
        <Navbar />
    <main class="max-w-[1200px] mx-auto flex flex-col items-center flex-1 w-full">
        <slot />
    </main>
    <Footer />
</body>
</html>

<style>
    html, body {
        margin: 0;
        width: 100%;
    }

    

    main {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
</style>
